{
  "name": "@savesutra/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SaveSutra app: React PWA, also packaged as the Android APK with Capacitor.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/icons.mjs && node scripts/splash.mjs",
    "cap:sync": "npm run build && cap sync android",
    "apk": "npm run cap:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capgo/capacitor-share-target": "^8.0.65",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@savesutra/core": "*",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.12.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "lucide-react": "^1.68.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "fake-indexeddb": "^6.2.4",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^3.2.4"
  },
  "license": "UNLICENSED"
}

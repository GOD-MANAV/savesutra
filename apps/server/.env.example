# --- Required ---
# Long random string; the app sends it as "Authorization: Bearer <token>". Generate: openssl rand -hex 32
API_TOKEN=
PORT=8787
DATA_DIR=./data

# --- AI (optional but recommended) ---
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Alias that always points to Google's current Flash model
GEMINI_MODEL=gemini-flash-latest
# Deep video analysis via yt-dlp (public videos only, deleted after analysis)
VIDEO_ANALYSIS=on
MAX_VIDEO_SECONDS=240
MAX_VIDEO_MB=40

# --- WhatsApp bot (optional) — see docs/WHATSAPP_SETUP.md ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v23.0
# Your own number, country code first, no +. Its saves go into your app library.
WHATSAPP_OWNER_NUMBER=
# Extra numbers allowed to use the bot (comma-separated). Leave empty for owner-only.
WHATSAPP_ALLOWED_NUMBERS=

# --- Web ---
PUBLIC_URL=
PRIVACY_URL=https://god-manav.github.io/savesutra/privacy.html
CORS_ORIGINS=https://god-manav.github.io,capacitor://localhost,https://localhost,http://localhost:5173
# Serve the built web app from this server (optional)
WEB_DIST=../web/dist
